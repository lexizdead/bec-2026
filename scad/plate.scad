// ======================================================================
//  ПЛАТФОРМА: проста плита з дірочками. Усе (кріплення коліс, мотори,
//  револьвер, котушку, плату, акумулятор) кріпимо стяжками, гвинтами М3
//  або термоклеєм.
//  Робот «Швидкісний кабель-укладач», BEST Engineering Competition
//
//  Розмітка (узгоджено з прошивкою, config.h):
//   - перед плити = +X. Отвір скидання Ø16 на x = −35 по центру.
//   - Датчик міток має стояти на 180 мм попереду отвору скидання
//     (DEF_DROP_OFFSET_MM 180), тобто на x = +145.
//   - Револьвер: центр на x −35, y +40 (ліворуч), отвір барабана над
//     отвором плити (revolver.scad, hole_ang = −90).
//  Друк: шар 0.28, 2 периметри, 15 %, без підтримок.
// ======================================================================

len_x   = 210;     // довжина (вздовж руху)
wid_y   = 130;     // ширина
thick   = 3;
x0      = -112;    // задній край (передній = x0 + len_x = +98)
hole_d  = 4;       // дірочки під стяжки / гвинти М3
pitch   = 10;      // крок дірочок
edge    = 5;       // суцільний край
drop_x  = -35;     // отвір скидання
drop_d  = 16;
$fn = 24;

difference() {
    translate([x0, -wid_y/2, 0]) cube([len_x, wid_y, thick]);
    // сітка дірочок (окрім кола навколо отвору скидання)
    for (x = [x0 + edge + hole_d/2 : pitch : x0 + len_x - edge - hole_d/2],
         y = [-wid_y/2 + edge + hole_d/2 : pitch : wid_y/2 - edge - hole_d/2])
        if (norm([x - drop_x, y]) > drop_d/2 + hole_d)
            translate([x, y, -1]) cylinder(d = hole_d, h = thick + 2);
    // отвір скидання
    translate([drop_x, 0, -1]) cylinder(d = drop_d, h = thick + 2, $fn = 48);
}
