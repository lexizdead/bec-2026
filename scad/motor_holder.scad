// ======================================================================
//  ТРИМАЧ TT-МОТОРА · sosny · BEST EC Day 2 (TD)
//
//  Тунель під мотор + полиця з прорізами під стяжки. Кріпиться знизу
//  рами на ламель (крок ламелей 20 мм = крок пар прорізів).
//  Мотор заходить у тунель заднім кінцем (де дроти), вихідний вал
//  лишається зовні — тунель його не перекриває.
//  Полиця тільки з ВНУТРІШНЬОГО боку: зовнішня стінка тунелю ставиться
//  врівень із краєм рами, тож колесо нічого не зачіпає. Друкувати 2 шт:
//  для другого боку деталь просто розвертається на 180° (універсальна).
//
//  25.10 15:40: мотор не влазив — товщина тунелю 20 → 23 мм (заміряно).
//  Висота 23 і висота вала над рамою (14.7) не змінились — колеса рівні.
//
//  Осі: X — уздовж мотора, Y — вздовж вала (23 мм), Z — висота (23 мм).
//  Друк: PLA, шар 0.2, 4 периметри, 30 %, полицею на стіл, без підтримок.
// ======================================================================

mot_y   = 23;      // товщина мотора (вздовж вала) — було 20
mot_z   = 23;      // висота мотора
fit     = 0.4;     // зазор (тугіше → 0.2)
len_x   = 32;      // довжина тунелю (вал мотора лишається вільним)
wall    = 2.5;
flange_t = 3;      // товщина полиці
flange_in = 26;    // полиця всередину рами від осі тунелю (зовні — врівень зі стінкою)
slot_l  = 4.4;     // проріз під стяжку до 3.6 мм (уздовж Y)
slot_w  = 2.2;     // (уздовж X)
slat_pitch = 20;   // крок ламелей рами
slat_w  = 5;

in_y = mot_y + fit;
in_z = mot_z + fit;
out_y = in_y + 2*wall;

difference() {
    union() {
        // полиця (лягає на раму)
        translate([0, -flange_in, 0]) cube([len_x, flange_in + out_y/2, flange_t]);
        // тунель
        translate([0, -out_y/2, 0]) cube([len_x, out_y, flange_t + in_z + wall]);
    }
    // порожнина під мотор
    translate([-1, -in_y/2, flange_t]) cube([len_x + 2, in_y, in_z]);
    // прорізи під стяжки: пари обабіч ламелі, з внутрішнього боку тунелю
    xc0 = (len_x - slat_pitch)/2;
    for (xc = [xc0, xc0 + slat_pitch], dx = [-1, 1])
        translate([xc + dx*(slat_w/2 + 0.5 + slot_w/2) - slot_w/2,
                   -(out_y/2 + 7) - slot_l/2, -1])
            cube([slot_w, slot_l, flange_t + 2]);
}
