// ======================================================================
//  РАМА-КАРКАС (за ескізом команди) · sosny · BEST EC Day 2 (TD)
//
//  Зовнішній контур → щілина під стяжки → внутрішній контур (з'єднані
//  перемичками). Всередині ззаду — суцільний майданчик під плату
//  YS 5CM*7CM на 4 стійках, далі поперечна балка, далі ламелі з
//  проміжками під стяжки та модулі. Перед = +X.
//
//  !!! ПЕРЕВІРИТИ ШТАНГЕНЦИРКУЛЕМ: pcb_hole_dx, pcb_hole_dy, pcb_hole_d !!!
//
//  ШВИДКА ВЕРСІЯ: висота 3 мм, контури 4 мм, 5 ламелей (крок 20 мм),
//  під платою нічого поперечного: стійки на вушках від 2 поздовжніх балок.
//  ЖОРСТКІСТЬ: внутрішній контур і 2 поздовжні балки — ребра rib_h = 6 мм
//  (ростуть ВГОРУ, низ рами плаский — висоти тримачів і датчиків не змінюються).
//  З 3 мм рама між осями прогиналась ~2 мм під 1 кг, ніс із датчиками
//  підскакував на ~3 мм; з ребрами 6 мм — ~0.3 мм.
//  РОЗКЛАДКА (крок 20, рахуємо від балки за платою = №0):
//    вільні колеса  — №0 + №1   (вісь x ≈ 82.5)
//    мотори         — №3 + №4   (вал уперед, вісь x ≈ 180.5)
//    датчики        — №5 + передній внутрішній контур (сенсори ~40 мм перед віссю)
//  Друк: PLA 0.28, 3 стінки, 4 шари верх/низ, 15 % infill, без підтримок
//  (бруски 4–5 мм виходять майже суцільними — це і дає міцність).
// ======================================================================

// --- габарит ---
len_x   = 202.5;  // довжина: передній внутрішній контур рівно на кроці 20 від ламелі №5
wid_y   = 130;    // ширина
frame_h = 3;      // висота зовнішнього контуру, перемичок і поперечної балки
rib_h   = 6;      // висота ребер жорсткості: внутрішній контур + 2 поздовжні балки

// --- контури ---
rim_out = 4;      // ширина зовнішнього контуру
gap     = 4;      // щілина між контурами (стяжки до 3.6 мм)
rim_in  = 4;      // ширина внутрішнього контуру
bridge  = 5;      // ширина перемичок між контурами

// --- майданчик під плату ---
pcb_w        = 50;     // плата вздовж руху (X)
pcb_l        = 70;     // плата поперек (Y)
pad_margin   = 4;      // запас навколо плати по X
pad_h        = 3;      // товщина майданчика / брусків
pad_solid    = false;  // true = суцільний майданчик під платою (довше друкується)
pcb_hole_dx  = 44;     // між центрами отворів по X
pcb_hole_dy  = 64;     // між центрами отворів по Y
stand_h      = 6;      // висота стійки (зазор під пайку)
stand_od     = 6;
screw_d      = 1.8;    // саморіз М2 (для М3 → 2.6)

// --- балка-розділювач і ламелі ---
div_w    = 5;      // поперечна балка за платою = «ламель №0» (крок 20 до №1)
slat_w   = 5;      // ширина ламелі
slat_h   = 3;      // висота ламелі
n_slats  = 5;      // ламелі №1…№5
slat_pitch = 20;   // = крок прорізів у всіх тримачах

// --- поздовжні балки (жорсткість) ---
long_y   = 15;     // ±15: не перекриває прорізи тримачів (мотор/колесо ±30…35, датчики ±17.5…22)
long_w   = 4;
arm_w    = 7;      // короткі вушка від балки до стійок плати

$fn = 32;

off      = rim_out + gap + rim_in;           // від краю до вікна
win_y    = wid_y - 2*off;                    // ширина вікна
pad_x0   = off;
pad_len  = pcb_w + 2*pad_margin;
div_x0   = pad_x0 + pad_len;
slat_x0  = div_x0 + div_w;                   // початок зони ламелей
slat_x1  = len_x - off;                      // кінець зони ламелей
div_c    = div_x0 + div_w/2;                 // центр балки-розділювача
pcb_cx   = pad_x0 + pad_len/2;

module ring(x0, y0, lx, ly, w, h) {
    difference() {
        translate([x0, y0, 0]) cube([lx, ly, h]);
        translate([x0 + w, y0 + w, -1]) cube([lx - 2*w, ly - 2*w, h + 2]);
    }
}

difference() {
    union() {
        // зовнішній контур (3 мм) і внутрішній контур (ребро rib_h)
        ring(0, -wid_y/2, len_x, wid_y, rim_out, frame_h);
        ring(rim_out + gap, -wid_y/2 + rim_out + gap,
             len_x - 2*(rim_out + gap), wid_y - 2*(rim_out + gap), rim_in, rib_h);
        // перемички: зад і перед по центру, боки — на балці і посередині ламелей
        for (x = [rim_out - 0.5, len_x - rim_out - gap - 0.5])
            translate([x, -bridge/2, 0]) cube([gap + 1, bridge, frame_h]);
        for (xc = [div_c, (slat_x0 + slat_x1)/2], s = [-1, 1])
            translate([xc - bridge/2, s > 0 ? wid_y/2 - rim_out - gap - 0.5
                                            : -wid_y/2 + rim_out - 0.5, 0])
                cube([bridge, gap + 1, frame_h]);
        // майданчик під плату + стійки
        if (pad_solid)
            translate([pad_x0 - 0.5, -win_y/2 - 0.5, 0]) cube([pad_len + 1, win_y + 1, pad_h]);
        for (sx = [-1, 1], sy = [-1, 1])
            translate([pcb_cx + sx*pcb_hole_dx/2, sy*pcb_hole_dy/2, 0])
                cylinder(d = stand_od, h = pad_h + stand_h);
        // поперечна балка
        translate([div_x0, -win_y/2 - 0.5, 0]) cube([div_w, win_y + 1, frame_h]);
        // ламелі
        for (i = [1 : n_slats])
            translate([div_c + i*slat_pitch - slat_w/2, -win_y/2 - 0.5, 0])
                cube([slat_w, win_y + 1, slat_h]);
        // 2 поздовжні балки-ребра через усю раму (від заднього до переднього
        // внутрішнього контуру); під платою — нижче за стійки (rib_h < pad_h + stand_h)
        for (sy = [-1, 1])
            translate([off - 0.5, sy*long_y - long_w/2, 0])
                cube([len_x - 2*off + 1, long_w, rib_h]);
        // вушка: стійки плати стоять на них (поперечних планок під платою немає)
        for (sx = [-1, 1], sy = [-1, 1])
            translate([pcb_cx + sx*pcb_hole_dx/2 - arm_w/2, sy > 0 ? long_y : -pcb_hole_dy/2 - arm_w/2, 0])
                cube([arm_w, pcb_hole_dy/2 + arm_w/2 - long_y, frame_h]);
    }
    for (sx = [-1, 1], sy = [-1, 1])
        translate([pcb_cx + sx*pcb_hole_dx/2, sy*pcb_hole_dy/2, -1])
            cylinder(d = screw_d, h = pad_h + stand_h + 2);
}
