// ======================================================================
//  ТРИМАЧ ДОВГОЇ ОСІ · sosny · Т-150
//  Із free_wheel.scad holder:
//   - уздовж осі звужений на 7 мм: 25.4 -> 18.4 мм;
//   - бічну полицю (йшла під колесо) прибрано: полиця тепер тільки
//     вперед/назад уздовж руху і не ширша за блок, тож колеса з обох боків
//     нічого не чіпають (зазор до маточини ~1.8 мм, там шайби).
//  Вісь — одна на два колеса: scad/wheel_axle_double.scad (holder_w = 18.4).
//  Друкувати 1 тримач на вісь.
//  Друк: PLA 0.28, 3 стінки, 30 %, полицею на стіл, без підтримок.
// ======================================================================

ax_d     = 6;      // вал осі
hole_fit = 0.5;    // отвір Ø6.5 — вісь крутиться вільно
block_x  = 20;     // блок уздовж руху
block_y  = 18.4;   // було 25.4 (-7 мм) — довжина отвору під вісь
axle_z   = 14.7;   // від рами до центру осі (= вал TT)
below    = 6;
flange_len = 52;   // полиця вздовж руху (по 16 мм з кожного боку блоку)
flange_t = 3;
slot_l = 4.4; slot_w = 2.2;   // прорізи під стяжки
$fn = 48;

module holder() {
    difference() {
        union() {
            translate([-flange_len/2, -block_y/2, 0]) cube([flange_len, block_y, flange_t]);
            translate([-block_x/2, -block_y/2, 0]) cube([block_x, block_y, axle_z + below]);
        }
        translate([0, 0, axle_z]) rotate([90, 0, 0])
            cylinder(d = ax_d + hole_fit, h = block_y + 2, center = true);
        for (x = [-1, 1]*(block_x/2 + 8), y = [-1, 1]*4.5)
            translate([x - slot_w/2, y - slot_l/2, -1]) cube([slot_w, slot_l, flange_t + 2]);
    }
}

holder();
