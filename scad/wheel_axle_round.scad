// ======================================================================
//  ВІСЬ ВІЛЬНОГО КОЛЕСА v5 (жовті TT-колеса з магазину) · sosny · Day 2
//
//  Як перша вісь із free_wheel.scad, але:
//   - D-кінець під конектор колеса на 20 мм довший (29 мм) і «кругліший»:
//     лиски 3.5 замість 3.0 + заокруглені кути → щільніше сидить у колесі;
//   - шайба-стопер є ТІЛЬКИ біля колеса; з іншого боку вал гладкий, тож вісь
//     просовується крізь тримач ззовні всередину рами;
//   - на внутрішній кінець надягається окремий stopper і приклеюється /
//     припаюється → вісь разом із колесом не вилітає.
//  Тримач (holder у free_wheel.scad, отвір Ø6.5) НЕ міняється.
//
//  Друк: PLA 0.2, 4 стінки, 100 %, без підтримок.
//  Вісь — СТОЯЧИ на торці вала (D-кінець угору), brim 5 мм, 2 шт разом.
//  Стопер — пласкою стороною на стіл.
// ======================================================================

part = "axle";     // "axle" або "stopper"

// --- D-кінець під колесо ---
hub_d    = 5.4;    // круглий діаметр
hub_flat = 3.5;    // між лисками (перша вісь 3.0 — колесо люфтило)
corner_r = 0.5;    // заокруглення кутів D-профілю
hub_len  = 29;     // було 9 → +20 мм

// --- шайба-стопер біля колеса ---
washer_d = 10;  washer_t = 1.5;

// --- вал у тримачі ---
ax_d     = 6;      // отвір тримача Ø6.5
block_y  = 25.4;   // товщина тримача
play     = 0.6;
stop_t   = 3;      // товщина окремого стопера
tail     = 1.5;    // запас за стопером
shaft_len = block_y + play + stop_t + tail;   // 30.5

stop_d   = 10;
stop_fit = 0.2;    // отвір стопера Ø6.2 — щільно, під клей

$fn = 96;

module d_profile() {
    offset(r = corner_r) offset(delta = -corner_r)
        intersection() {
            circle(d = hub_d);
            square([hub_flat, hub_d + 1], center = true);
        }
}

module axle() {
    // друк стоячи на торці вала: вал → шайба → D-кінець угору
    cylinder(d = ax_d, h = shaft_len);
    translate([0, 0, shaft_len]) cylinder(d = washer_d, h = washer_t);
    translate([0, 0, shaft_len + washer_t]) {
        linear_extrude(hub_len - 0.6) d_profile();
        translate([0, 0, hub_len - 0.6]) linear_extrude(0.6, scale = 0.8) d_profile(); // фаска
    }
}

module stopper() {
    difference() {
        cylinder(d = stop_d, h = stop_t);
        translate([0, 0, -1]) cylinder(d = ax_d + stop_fit, h = stop_t + 2);
    }
}

if (part == "axle")    axle();
if (part == "stopper") stopper();
