// ======================================================================
//  РЕВОЛЬВЕРНИЙ МАГАЗИН НА 9 ШКАНТІВ (90 x 10 мм), SG90
//  Робот «Швидкісний кабель-укладач», BEST Engineering Competition
//
//  Як працює: шканти стоять вертикально в 9 трубках барабана і спираються
//  на нерухому плиту. У плиті ОДИН отвір. Серво крутить барабан кроками по
//  20° (як MAG_ANGLES у config.h: 0, 20, 40 … 180). На старті жодна трубка
//  не над отвором; після k-го кроку над отвором трубка k, шкант падає.
//
//  Деталі (2 шт., без підтримок):
//    base — плита з отвором, вирізом під SG90 і ніжками (друкується
//           догори дном, ніжками вгору — так уже повернута)
//    drum — барабан із трубками (друкується як є, стеля маточини — міст ~40 мм)
//
//  Складання:
//   1. SG90 вставити в плиту ЗНИЗУ (вал угору, дроти вниз), вушка серво
//      прикрутити гвинтами з комплекту зверху крізь плиту.
//   2. Поміряти, на скільки верх качалки серво вище плити, і вписати в
//      horn_top ДО друку барабана (на око ~8 мм).
//   3. Залити прошивку, викликати magHome() (серво в 0°), тоді надіти
//      барабан так, щоб камера 1 (з виступом) була за 20° до отвору.
//      Качалку прикрутити до стелі маточини саморізами з комплекту
//      (отвори вже є) + крапля термоклею.
//   4. Якщо перший крок крутить камеру 1 ВІД отвору: у config.h зробити
//      MAG_ANGLES = {180,160,…,0} і зібрати барабан, коли серво в 180°.
//
//  На роботі (chassis.scad): центр револьвера x −35, y +40 (лівий бік),
//  отвір дивиться на центр робота і стоїть точно над отвором деки
//  x −35, y 0. Від датчика міток до цієї точки 180 мм = DEF_DROP_OFFSET_MM.
//  Ніжки клеїти до деки термоклеєм.
//  Друк швидкий: шар 0.28, 2 периметри, заповнення 10 %.
//  Координати: Z = 0 це верх плити, вісь серво в (0,0), X вперед.
// ======================================================================

part = "all";   // [all, drum, base]

// ---------- Шканти ----------
dowel_d  = 10;     // НАЙБІЛЬШИЙ з поміряних
dowel_l  = 90;
n        = 9;
step_deg = 20;     // крок барабана = крок MAG_ANGLES

// ---------- Барабан ----------
ch_d     = dowel_d + 1.0;   // внутрішній діаметр трубки
tube_w   = 1.2;             // стінка трубки
R        = 40;              // радіус кола камер
tube_h   = 25;              // висота трубок (шкант стирчить вище — так і треба)
web_t    = 2.4;             // кільце, що з'єднує трубки
gap      = 0.5;             // зазор між барабаном і плитою
horn_top = 8;               // верх качалки над плитою, мм (ПОМІРЯТИ!)
hub_r    = 19;              // порожнина під верх корпусу серво
hub_w    = 2.4;

// ---------- Плита ----------
plate_t  = 2.4;
hole_d   = dowel_d + 2.5;   // отвір скидання
hole_ang = -90;             // напрямок отвору від осі: -90 = на центр робота (chassis.scad)
leg_h    = 23;              // висота ніжок (під корпусом серво має лишитись місце)
leg_r    = 36;              // ніжки на цьому радіусі
leg_rel  = [-60, 60, 90, -90];   // кути ніжок відносно отвору (не під отвором)

// ---------- SG90 ----------
sv_l     = 23.0;   // виріз під корпус
sv_w     = 12.6;
sv_off   = 5.6;    // від валу до центру корпусу
sv_hole  = 27.8;   // між отворами вушок
$fn = 48;

// ======================= похідні величини =============================
outer_r = R + ch_d/2 + tube_w;
plate_r = outer_r + 2;
ceil_z  = horn_top - gap;      // низ стелі маточини від низу барабана
pitch   = 2 * R * sin(step_deg / 2);

assert(pitch > ch_d + 0.5, "камери налазять одна на одну: збільште R");
assert(pitch > hole_d/2 + dowel_d/2 + 1, "сусідня камера провалиться в отвір: збільште R або зменште hole_d");
assert(n * step_deg <= 180, "серво SG90 має лише 180°");
echo(str("Барабан Ø", 2*outer_r, " мм, плита Ø", 2*plate_r, " мм"));
echo(str("Між камерами ", round(pitch*10)/10, " мм; верх шкантів на ", plate_t + leg_h + gap + dowel_l, " мм над платформою"));

function cam_ang(k) = hole_ang - step_deg * k;   // кут камери k на старті

// =========================== модулі ===================================
module drum() {
    difference() {
        union() {
            // кільце-перетинка
            difference() {
                cylinder(r = outer_r, h = web_t);
                translate([0, 0, -1]) cylinder(r = hub_r, h = web_t + 2);
            }
            // трубки камер
            for (k = [1 : n]) rotate([0, 0, cam_ang(k)]) translate([R, 0, 0])
                cylinder(d = ch_d + 2*tube_w, h = tube_h);
            // маточина зі стелею
            difference() {
                cylinder(r = hub_r + hub_w, h = ceil_z + 3);
                translate([0, 0, -1]) cylinder(r = hub_r, h = ceil_z + 1);
            }
            // виступ-мітка на камері 1
            rotate([0, 0, cam_ang(1)]) translate([outer_r - 1, -1.5, 0]) cube([4, 3, tube_h]);
        }
        // камери
        for (k = [1 : n]) rotate([0, 0, cam_ang(k)]) translate([R, 0, -1])
            cylinder(d = ch_d, h = tube_h + 2);
        // доступ до центрального гвинта качалки
        translate([0, 0, -1]) cylinder(d = 6, h = ceil_z + 5);
        // отвори під саморізи качалки (будь-яка качалка з комплекту)
        for (a = [0, 90, 180, 270], r = [8, 11, 14])
            rotate([0, 0, a]) translate([r, 0, ceil_z - 1]) cylinder(d = 1.5, h = 5);
    }
}

module base() {
    difference() {
        union() {
            translate([0, 0, -plate_t]) cylinder(r = plate_r, h = plate_t);
            for (la = leg_rel) rotate([0, 0, hole_ang + la]) translate([leg_r, 0, -plate_t - leg_h]) {
                translate([-5, -5, 0]) cube([10, 10, leg_h + 0.01]);
                translate([-8, -8, 0]) cube([16, 16, 3]);
            }
        }
        // виріз під корпус SG90 (вал у центрі плити)
        translate([-sv_off - sv_l/2, -sv_w/2, -plate_t - 1]) cube([sv_l, sv_w, plate_t + 2]);
        for (dx = [-1, 1])
            translate([-sv_off + dx*sv_hole/2, 0, -plate_t - 1]) cylinder(d = 2.2, h = plate_t + 2);
        // отвір скидання
        rotate([0, 0, hole_ang]) translate([R, 0, -plate_t - 1]) cylinder(d = hole_d, h = plate_t + 2);
        // отвори в лапках (гвинт М3, саморіз або термоклей)
        for (la = leg_rel) rotate([0, 0, hole_ang + la]) translate([leg_r, 0, -plate_t - leg_h - 1]) cylinder(d = 3.4, h = 5);
    }
}

// =========================== вивід ====================================
if (part == "all") {
    color("gray") base();
    color("orange") translate([0, 0, gap]) drum();
    // шканти на старті
    for (k = [1 : n]) color("burlywood") rotate([0, 0, cam_ang(k)])
        translate([R, 0, 0]) cylinder(d = dowel_d, h = dowel_l);
    // макет SG90
    %translate([-sv_off - 11.4, -6.2, -21.4]) cube([22.8, 12.4, 22.7]);
    // дека робота
    %translate([-80, -100, -plate_t - leg_h - 3]) cube([160, 124, 3]);
}
else if (part == "drum") drum();
else if (part == "base") rotate([180, 0, 0]) base();   // верх плити на столі, ніжки вгору
